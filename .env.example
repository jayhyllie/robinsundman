# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/sundman"

# Clerk (https://clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Hosted auth pages in this app (required when Account Portal is unavailable)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/admin
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/admin
# With robinsundman.se + Clerk DNS — use the .se Frontend API host (NOT *.vercel.app):
NEXT_PUBLIC_CLERK_DOMAIN=clerk.robinsundman.se
# Do NOT set NEXT_PUBLIC_CLERK_PROXY_URL when using custom Clerk DNS.

# App URLs
# For local dev on your computer only:
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
# CLIENT_URL=http://localhost:3000
#
# For testing on phone (same Wi‑Fi): use your computer's LAN IP instead of localhost.
# Find it with: ipconfig getifaddr en0   (Mac)  or  ip addr   (Linux)
# Example:
# NEXT_PUBLIC_APP_URL=http://192.168.1.42:3000
# NEXT_PUBLIC_SOCKET_URL=http://192.168.1.42:3001
# CLIENT_URL=http://192.168.1.42:3000

NEXT_PUBLIC_APP_URL=http://192.168.0.17:3000
NEXT_PUBLIC_SOCKET_URL=http://192.168.0.17:3001
# Socket server (Railway/Fly.io)
SOCKET_SERVER_SECRET=your-random-secret-here
SOCKET_SERVER_URL=http://localhost:3001
CLIENT_URL=http://192.168.0.17:3000
PORT=3001

# Optional: skip env validation during Docker builds
# SKIP_ENV_VALIDATION=1
